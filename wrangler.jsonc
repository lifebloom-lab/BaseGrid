{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "basegrid",
  "main": "worker.js",
  "compatibility_date": "2026-09-30",
  "workers_dev": true,
  "build": { "command": "node scripts/build.mjs" },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "none"
  },
  "observability": { "enabled": false }
}
